rules_version = '2';
// Cada utilizador só lê e escreve os SEUS próprios dados (users/{o-seu-uid}/...).
// Tudo o resto fica bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Hábitos (um documento por hábito)
    match /users/{uid}/habits/{habitId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.keys().size() <= 15;
    }

    // Conquistas
    match /users/{uid}/meta/{docId} {
      allow read, write: if isOwner(uid);
    }

    // Aparelhos registados para notificações push
    match /users/{uid}/devices/{token} {
      allow read, write: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
